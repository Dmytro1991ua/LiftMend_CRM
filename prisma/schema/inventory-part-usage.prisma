model InventoryPartUsage {
  id              String        @id @default(uuid())
  repairJobId     String
  inventoryPartId String        @db.Uuid
  quantity        Int
  createdAt       DateTime?     @default(now()) @db.Timestamp(6)
  repairJob       RepairJob     @relation(fields: [repairJobId], references: [id])
  inventoryPart   InventoryPart @relation(fields: [inventoryPartId], references: [id])
}
